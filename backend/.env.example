# --- Database ---
# Supabase: Project settings -> Database -> Connection string (URI, Session pooler)
# Example: postgresql+psycopg://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/jumysaq

# For local fast start without Postgres, you can use SQLite:
# DATABASE_URL=sqlite:///./jumysaq.db

# --- Auth ---
JWT_SECRET=change-me-super-secret-please-rotate-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- AI: Google Gemini (primary) ---
# https://aistudio.google.com/app/apikey  (free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- AI: Groq (fallback, optional) ---
# https://console.groq.com/keys  (free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Telegram (used by backend to notify via bot) ---
TELEGRAM_BOT_TOKEN=

# --- Misc ---
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
# Ссылки «открыть вакансию» в Telegram (без слэша в конце)
PUBLIC_APP_URL=http://localhost:3000
